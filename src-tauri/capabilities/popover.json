{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "popover",
  "description": "Allows the tray popover webview to talk to the desktop app commands.",
  "windows": ["popover"],
  "remote": {
    "urls": ["http://127.0.0.1:*", "http://localhost:*"]
  },
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "panel-commands"
  ]
}